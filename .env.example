# Local PostgreSQL from docker-compose.yml. Use unquoted values.
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:15432/clinic
SPRING_DATASOURCE_USERNAME=clinic
SPRING_DATASOURCE_PASSWORD=localdev

# Keycloak
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/sokhasa-clinic

# Telegram Notifications (optional)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_RETRY_MAX_ATTEMPTS=5
